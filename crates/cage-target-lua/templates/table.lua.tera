{#- Official Lua per-table template (design §22 G2).
    Registered under the target's `file_template` name (default
    `{table}.lua`), rendered once per table in name order. Decisions are
    precomputed in context: `header_what`, `primary_key_lit`,
    `member_fields` (name order — member/type/doc/default/required);
    pure text conversion goes through the `lua_string` filter. -#}
-- <auto-generated>
--   Generated by Cage — do not edit.
--   schema: {{ schema_hash | default(value="(unavailable)") }}
--   {{ header_what }}
-- </auto-generated>

local M = {}

M.name = {{ table.name | lua_string }}
{% if table.description %}M.description = {{ table.description | lua_string }}
{% endif %}{% if primary_key_lit %}M.primary_key = { {{ primary_key_lit }} }
{% endif %}
-- Field metadata (name order).
M.fields = {
{% for f in member_fields %}{% if f.doc %}    -- {{ f.doc }}
{% endif %}    { name = {{ f.name | lua_string }}, key = {{ f.member | lua_string }}, type = "{{ f.type_label }}", required = {{ f.required_str }} },
{% endfor %}}

-- Schema defaults by field key.
M.defaults = {
{% for f in member_fields %}{% if f.default_expr %}    {{ f.member }} = {{ f.default_expr }},
{% endif %}{% endfor %}}

local function copy_default(v)
    if type(v) ~= "table" then
        return v
    end
    local copy = {}
    for k, item in pairs(v) do
        copy[k] = copy_default(item)
    end
    return copy
end

--- Build one row: caller-supplied values win, missing
--- fields fall back to M.defaults (copied, not shared).
function M.new(t)
    local row = {}
    for k, v in pairs(t or {}) do
        row[k] = v
    end
    for k, v in pairs(M.defaults) do
        if row[k] == nil then
            row[k] = copy_default(v)
        end
    end
    return row
end

return M
