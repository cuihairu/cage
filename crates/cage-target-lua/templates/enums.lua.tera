{#- Official Lua shared-enums template (design §22 G2).
    Registered under the target's `enums_file` name and rendered once,
    only when the schema has at least one non-empty enum. `emitted_enums`
    is precomputed in context (name order; `ident`/`member` are
    collision-free, `value_lit` the Lua literal). -#}
-- <auto-generated>
--   Generated by Cage — do not edit.
--   schema: {{ schema_hash | default(value="(unavailable)") }}
--   enums:  shared definitions
-- </auto-generated>

local M = {}
{% for e in emitted_enums %}
-- {{ e.name }}{% if e.description %} — {{ e.description }}{% endif %}
M.{{ e.ident }} = {
{% for m in e.members %}    {{ m.member }} = {{ m.value_lit }}{% if m.description %}, -- {{ m.description }}{% else %},{% endif %}
{% endfor %}}
{% endfor %}

return M
