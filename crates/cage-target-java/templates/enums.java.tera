{#- Official Java shared-enums template (design §22 G2).
    Registered under the target's `enums_file` name and rendered once,
    only when the schema has at least one non-empty enum. `emitted_enums`
    is precomputed in context (name order; `ident` allocated against the
    holder's nested-type namespace seeded with the holder name, `banner`
    the single-line declaration Javadoc body, `payload` the enum's
    underlying type (`int` / `long` / `String`), members carry the full
    constant decl line with payload literal, separator and optional
    trailing note). The holder file stem follows the holder class ident,
    so the engine's artifact is re-pathed in `generate`. -#}package {{ package }};

// <auto-generated>
//   Generated by Cage — do not edit.
//   schema: {{ schema_hash | default(value="(unavailable)") }}
//   enums:  shared definitions
// </auto-generated>

public final class {{ holder_ident }} {
    private {{ holder_ident }}() {}

{% for e in emitted_enums %}
    /** {{ e.banner }} */
    public enum {{ e.ident }} {
{% for m in e.members %}{% if m.doc %}        /** {{ m.doc }} */
{% endif %}        {{ m.decl }}
{% endfor %}

        public final {{ e.payload }} value;

        {{ e.ident }}({{ e.payload }} value) {
            this.value = value;
        }
    }
{% endfor %}}
