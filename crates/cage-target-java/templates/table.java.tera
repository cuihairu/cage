{#- Official Java per-table template (design §22 G2).
    Registered under the target's `file_template` name (default
    `{table}.java`), rendered once per table in name order. Decisions are
    precomputed in context: `header_what`, `package`, `imports` (the
    sorted full-name block; an empty list drops the import block and its
    trailing blank line), `banner_head` / `banner_desc` (the class
    Javadoc: description lines above the head, or a single line for the
    bare head), `class_ident` (allocated against the shared package-level
    namespace), and `members` (name order — the full decl line with
    optionality and default already resolved, optional doc). The file
    stem follows the class ident, so the engine's artifacts are re-pathed
    in `generate`. -#}package {{ package }};

// <auto-generated>
//   Generated by Cage — do not edit.
//   schema: {{ schema_hash | default(value="(unavailable)") }}
//   {{ header_what }}
// </auto-generated>

{% for imp in imports %}import {{ imp }};
{% endfor %}{% if imports %}
{% endif %}{% if banner_desc %}/**
 * {{ banner_desc }}
 * {{ banner_head }}
 */
{% else %}/** {{ banner_head }} */
{% endif %}public final class {{ class_ident }} {
{% for m in members %}{% if not loop.first %}
{% endif %}{% if m.doc %}    /** {{ m.doc }} */
{% endif %}    public {{ m.decl }}
{% endfor %}}
