{% for e in emitted_enums %}{% if not loop.first %}
{% endif %}// {{ e.name }}{% if e.description %} — {{ e.description }}{% endif %}
export const {{ e.export }} = {
{% for m in e.members %}  {{ m.key }}: {{ m.value }},{% if m.desc %} // {{ m.desc }}{% endif %}
{% endfor %}} as const;
export type {{ e.export }} = (typeof {{ e.export }})[keyof typeof {{ e.export }}];
{% endfor %}