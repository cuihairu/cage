{% if import_line %}{{ import_line }}

{% endif %}{% if description %}/**
 * {{ description }}
 * {{ banner }}
 */
{% else %}/** {{ banner }} */
{% endif %}{% if interface_empty %}export interface {{ ident }} {}
{% else %}export interface {{ ident }} {
{% for m in members %}{% if m.doc %}  /** {{ m.doc }} */
{% endif %}  {{ m.prop }}{{ m.opt }}: {{ m.ty }};
{% endfor %}}
{% endif %}

{% if defaults_empty %}export const {{ ident }}Defaults: Partial<{{ ident }}> = {};
{% else %}export const {{ ident }}Defaults: Partial<{{ ident }}> = {
{% for d in default_rows %}  {{ d.prop }}: {{ d.expr }},
{% endfor %}};
{% endif %}
export function new{{ ident }}(init: Partial<{{ ident }}> = {}): {{ ident }} {
  return { {{ factory_inline }}{% if factory_inline %}, {% endif %}...init } as {{ ident }};
}
