#nullable enable

using System;
using System.Collections.Generic;

namespace {{ namespace_x }}
{

{% if summary_desc %}    /// <summary>
    /// {{ summary_head }}
    /// <para>{{ summary_desc }}</para>
    /// </summary>
{% else %}    /// <summary>{{ summary_head }}</summary>
{% endif %}    public sealed class {{ class_ident }}
    {
{% for m in members %}{% if not loop.first %}
{% endif %}{% if m.doc %}        /// <summary>{{ m.doc }}</summary>
{% endif %}        public {{ m.ty }} {{ m.member }} { get; init; }{{ m.init }}
{% endfor %}    }
}
