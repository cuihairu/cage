{#- Official C# shared-enums template (design §22 G2).
    Registered under the target's `enums_file` name and rendered once,
    only when the schema has at least one non-empty enum. `emitted_enums`
    is precomputed in context (name order; `is_enum` decides the integral
    enum vs static string-constants class shape, `backing` carries the
    integer suffix, `decl` the full member declaration line). -#}
// <auto-generated>
//   Generated by Cage — do not edit.
//   schema: {{ schema_hash | default(value="(unavailable)") }}
//   enums:  shared definitions
// </auto-generated>

#nullable enable

using System;
using System.Collections.Generic;

namespace {{ namespace_x }}
{
{% for e in emitted_enums %}{% if not loop.first %}
{% endif %}    /// <summary>{{ e.summary }}</summary>
{% if e.is_enum %}    public enum {{ e.ident }}{{ e.backing }}
    {
{% for m in e.members %}{% if not loop.first %}
{% endif %}{% if m.doc %}        /// <summary>{{ m.doc }}</summary>
{% endif %}        {{ m.decl }}
{% endfor %}    }
{% else %}    public static class {{ e.ident }}
    {
{% for m in e.members %}{% if not loop.first %}
{% endif %}{% if m.doc %}        /// <summary>{{ m.doc }}</summary>
{% endif %}        {{ m.decl }}
{% endfor %}    }
{% endif %}{% endfor %}}
