{#- Official C++ shared-enums header template (design §22 G2).
    Registered under the target's `enums_file` name and rendered once,
    only when the schema has at least one non-empty enum. `emitted_enums`
    is precomputed in context (name order; `ident` allocated against the
    shared file-set namespace, `integral` picks the `enum class` vs
    string-constants-namespace shape, `decl` the full member line). -#}// <auto-generated>
//   Generated by Cage — do not edit.
//   schema: {{ schema_hash | default(value="(unavailable)") }}
//   enums:  shared definitions
// </auto-generated>

#pragma once

{% for inc in angle %}#include <{{ inc }}>
{% endfor %}{% if angle %}
{% endif %}namespace {{ namespace }} {

{% for e in emitted_enums %}// {{ e.ident }}{% if e.description %} — {{ e.description }}{% endif %}
{% if e.integral %}enum class {{ e.ident }} : {{ e.backing }} {
{% for m in e.members %}    {{ m.decl }}{% if m.desc %}  // {{ m.desc }}{% endif %}
{% endfor %}};
{% else %}namespace {{ e.ident }} {
{% for m in e.members %}    {{ m.decl }}{% if m.desc %}  // {{ m.desc }}{% endif %}
{% endfor %}}
{% endif %}
{% endfor %}}  // namespace {{ namespace }}
