#pragma once

{% for inc in includes %}#include <{{ inc }}>
{% endfor %}{% if includes %}
{% endif %}{% if enums_header %}#include "{{ enums_file }}"

{% endif %}namespace {{ namespace }} {

// {{ banner_head }}
{% if banner_desc %}// {{ banner_desc }}
{% endif %}struct {{ struct_name }} {
{% for m in members %}{% if m.doc %}    // {{ m.doc }}
{% endif %}    {{ m.decl }}
{% endfor %}};

}  // namespace {{ namespace }}
